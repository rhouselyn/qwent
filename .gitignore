# ===== 私密数据:解密后的聊天记录、密钥、媒体缓存(3.8GB,严禁上传)=====
data/

# ===== 本机配置,含真实 API key =====
backend/config.json

# ===== 大模型权重(约 250MB 必需部分,见 README 下载说明)=====
models/

# ===== refs:本地研究资料不入库,仅内置运行时必需的 ChatTrace =====
refs/*
!refs/ChatTrace
refs/ChatTrace/.git/
refs/ChatTrace/.github/
refs/ChatTrace/.gitignore
refs/ChatTrace/docs/
refs/ChatTrace/tests/
refs/ChatTrace/RELEASE_NOTES_*
refs/ChatTrace/REFERENCES.md

# ===== 日志与运行时产物 =====
*.log
*.lock

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ===== OS / 编辑器 =====
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
