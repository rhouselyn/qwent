{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qwent",
  "version": "1.0.0",
  "identifier": "cn.local.wechat-assistant",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qwent",
        "width": 1260,
        "height": 800,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
